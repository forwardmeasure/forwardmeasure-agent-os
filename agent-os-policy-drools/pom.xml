<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.forwardmeasure.agentos</groupId>
        <artifactId>forwardmeasure-agent-os-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>com.forwardmeasure.agentos</groupId>
    <artifactId>agent-os-policy-drools</artifactId>
    <packaging>jar</packaging>

    <name>Agent OS :: Policy :: Drools (decision-engine) Adapter</name>
    <description>PolicyEvaluator adapter that delegates every decision to a forwardmeasure-decision-engine server over gRPC (EvaluationService.Evaluate) - the Drools-based alternative to agent-os-policy-opa's OPA call-out, selected at runtime via agent-os.policy.evaluator=drools (see PolicyEvaluatorProfile, agent-os-domain). Both adapters are swappable implementation details behind the same PolicyEvaluator port; no other module depends on this one directly except a framework binding wiring the port. Requires decision-engine-api-language-bindings-java-grpc from the sibling forwardmeasure-decision-engine repository to be built/published first - see forwardmeasure.decisionengine.version.</description>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>agent-os-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>com.forwardmeasure.decisionengine</groupId>
            <artifactId>decision-engine-api-language-bindings-java-grpc</artifactId>
            <version>${forwardmeasure.decisionengine.version}</version>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-stub</artifactId>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-protobuf</artifactId>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-netty-shaded</artifactId>
            <scope>runtime</scope>
            <!-- ManagedChannelBuilder.forTarget(...) needs a real transport implementation
                 registered via ServiceLoader at runtime - grpc-stub/grpc-protobuf alone only give
                 the generated stub and message types, not a working Channel. -->
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-testing</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
