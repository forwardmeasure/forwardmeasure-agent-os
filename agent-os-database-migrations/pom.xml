<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.forwardmeasure.agentos</groupId>
        <artifactId>forwardmeasure-agent-os-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>com.forwardmeasure.agentos</groupId>
    <artifactId>agent-os-database-migrations</artifactId>
    <packaging>jar</packaging>

    <name>ForwardMeasure Agent OS :: Database Migrations</name>
    <description>Aggregate tenant-schema Liquibase changelog for the governance and execution verticals.</description>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>agent-os-governance-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>agent-os-execution-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>com.forwardmeasure.jpa</groupId>
            <artifactId>forwardmeasure-jpa-liquibase</artifactId>
        </dependency>
        <dependency>
            <groupId>com.forwardmeasure.jpa</groupId>
            <artifactId>forwardmeasure-jpa-datasource</artifactId>
        </dependency>
        <dependency>
            <!-- Real, compile-scope dependency (not test-only): AgentOsTenantMigrator
                 (src/main/java) reuses this artifact's own OpenWorkflowTenantMigrator as a
                 library for real database-per-tenant provisioning - the same reuse
                 OpenWorkflowTenantMigrator's own javadoc documents for forwardmeasure-entity-
                 intelligence and forwardmeasure-decision-engine, rather than a second, parallel
                 tenant-provisioning implementation.

                 Exclusions mirror forwardmeasure-entity-intelligence-migrations' own pom exactly:
                 openworkflow-migrations also drives Cassandra migrations that this module never
                 touches (only the Postgres/Liquibase side), and excluding the Cassandra driver at
                 the root removes duplicate-finder conflicts (commons-logging, httpclient5) it would
                 otherwise drag in. -->
            <groupId>com.forwardmeasure.openworkflow</groupId>
            <artifactId>openworkflow-migrations</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.apache.cassandra</groupId>
                    <artifactId>java-driver-core</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.httpcomponents.client5</groupId>
                    <artifactId>httpclient5</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.forwardmeasure.testcontainers</groupId>
            <artifactId>forwardmeasure-testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
