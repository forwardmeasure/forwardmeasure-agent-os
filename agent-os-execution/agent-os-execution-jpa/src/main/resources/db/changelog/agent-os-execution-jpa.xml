<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    logicalFilePath="db/changelog/agent-os-execution-jpa.xml"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="agent-os-execution-jpa-001" author="forwardmeasure">
        <comment>Create the agent execution table.</comment>

        <createSequence
            sequenceName="agent_execution_id_seq"
            startValue="1"
            incrementBy="1"
            cacheSize="1" />

        <createTable tableName="agent_execution">
            <column
                name="id"
                type="BIGINT"
                defaultValueSequenceNext="agent_execution_id_seq">
                <constraints
                    primaryKey="true"
                    primaryKeyName="pk_agent_execution"
                    nullable="false" />
            </column>
            <column name="version" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false" />
            </column>
            <column name="uuid" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints
                    nullable="false"
                    unique="true"
                    uniqueConstraintName="uk_agent_execution_uuid" />
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
            <column name="owner_id" type="BIGINT">
                <constraints nullable="false" />
            </column>
            <column name="command_id" type="VARCHAR(160)">
                <constraints nullable="false" />
            </column>
            <column name="namespace" type="VARCHAR(63)">
                <constraints nullable="false" />
            </column>
            <column name="name" type="VARCHAR(63)">
                <constraints nullable="false" />
            </column>
            <column name="agent_version" type="VARCHAR(32)">
                <constraints nullable="false" />
            </column>
            <column name="workflow_id" type="UUID">
                <constraints nullable="false" />
            </column>
            <column name="workflow_revision_id" type="UUID">
                <constraints nullable="false" />
            </column>
            <column name="workflow_revision_digest" type="VARCHAR(64)">
                <constraints nullable="false" />
            </column>
            <column name="open_workflow_execution_id" type="UUID" />
            <column name="open_workflow_revision" type="BIGINT" />
            <column name="engine_id" type="VARCHAR(160)" />
            <column name="protocol" type="VARCHAR(10)">
                <constraints nullable="false" />
            </column>
            <column name="context_id" type="VARCHAR(160)" />
            <column name="state" type="VARCHAR(20)">
                <constraints nullable="false" />
            </column>
            <column name="correlation_id" type="VARCHAR(160)">
                <constraints nullable="false" />
            </column>
            <column name="input" type="JSONB">
                <constraints nullable="false" />
            </column>
            <column name="output" type="JSONB" />
            <column name="last_failure" type="TEXT" />
            <column name="accepted_at" type="TIMESTAMP WITH TIME ZONE" />
        </createTable>

        <sql dbms="postgresql">
            ALTER SEQUENCE agent_execution_id_seq OWNED BY agent_execution.id;
        </sql>

        <addUniqueConstraint
            tableName="agent_execution"
            columnNames="command_id"
            constraintName="uk_agent_execution_command_id" />

        <addForeignKeyConstraint
            baseTableName="agent_execution"
            baseColumnNames="owner_id"
            referencedTableName="actor"
            referencedColumnNames="id"
            constraintName="fk_agent_execution_owner"
            onDelete="RESTRICT" />

        <createIndex tableName="agent_execution" indexName="idx_agent_execution_list_cursor">
            <column name="created_at" descending="true" />
            <column name="id" descending="true" />
        </createIndex>

        <createIndex tableName="agent_execution" indexName="idx_agent_execution_open_workflow_execution_id">
            <column name="open_workflow_execution_id" />
        </createIndex>

        <sql dbms="postgresql">
            ALTER TABLE agent_execution
            ADD CONSTRAINT chk_agent_execution_state
            CHECK (state IN (
                'SUBMITTED', 'RUNNING', 'PAUSED',
                'COMPLETED', 'FAILED', 'CANCELLED'));

            ALTER TABLE agent_execution
            ADD CONSTRAINT chk_agent_execution_protocol
            CHECK (protocol IN ('REST', 'A2A', 'MCP'));

            ALTER TABLE agent_execution
            ADD CONSTRAINT chk_agent_execution_open_workflow_binding_complete
            CHECK (
                (open_workflow_execution_id IS NULL AND open_workflow_revision IS NULL AND engine_id IS NULL)
                OR (open_workflow_execution_id IS NOT NULL AND open_workflow_revision IS NOT NULL AND engine_id IS NOT NULL));
        </sql>

        <rollback>
            <dropTable tableName="agent_execution" />
            <dropSequence sequenceName="agent_execution_id_seq" />
        </rollback>
    </changeSet>
</databaseChangeLog>
