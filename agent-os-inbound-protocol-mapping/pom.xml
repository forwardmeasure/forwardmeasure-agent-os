<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.forwardmeasure.agentos</groupId>
        <artifactId>forwardmeasure-agent-os-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>com.forwardmeasure.agentos</groupId>
    <artifactId>agent-os-inbound-protocol-mapping</artifactId>
    <packaging>jar</packaging>

    <name>ForwardMeasure Agent OS :: Inbound Protocol Mapping</name>
    <description>Stateless mapping from the domain release representation (coordinates, AgentDefinition, WorkflowReleaseBinding) to protocol-specific wire representations: A2A AgentCard, MCP Tool, A2UI surface, OASF Record. Inbound-facing (how external callers discover/invoke us), as distinct from agent-os-openworkflow-client's outbound-facing mapping (how we call OpenWorkflow). Pure functions - no I/O, no persistence, no lookups; the caller resolves the release and passes it in. Was agent-os-protocol-projection; renamed because 'projection' already had a specific, different meaning in this reactor (the now-eliminated Kafka CQRS read-model), and 'mapping' correctly matches the codebase's own MapStruct-based vocabulary for this kind of domain-to-contract transformation.</description>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>agent-os-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>org.a2aproject.sdk</groupId>
            <artifactId>a2a-java-sdk-spec</artifactId>
        </dependency>
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
