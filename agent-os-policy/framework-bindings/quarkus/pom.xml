<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.forwardmeasure.agentos</groupId>
        <artifactId>agent-os-policy-framework-bindings</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>com.forwardmeasure.agentos</groupId>
    <artifactId>agent-os-policy-quarkus</artifactId>
    <packaging>jar</packaging>

    <name>ForwardMeasure Agent OS :: Policy :: Quarkus</name>
    <description>Quarkus wiring and JAX-RS resource hosting for policy evaluation, using the shared agent-os-quarkus-actor-binding for auth/claims resolution. No datasource - this vertical has no persistence of its own. Wiring only - no Dockerfile, no application.yaml, no container-image profile; see agent-os-deployments/policy/quarkus (agent-os-policy-quarkus-service) for the deployable assembly that depends on this module, mirroring openworkflow-definition-management-quarkus/-quarkus-service's split exactly.</description>

    <dependencyManagement>
        <dependencies>
        <dependency>
            <groupId>com.forwardmeasure.platform</groupId>
            <artifactId>forwardmeasure-platform-quarkus-bom</artifactId>
            <version>${forwardmeasure.platform.version}</version>
            <type>pom</type>
            <scope>import</scope>
        </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>agent-os-policy-jaxrs</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>agent-os-policy-opa</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>agent-os-policy-drools</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>agent-os-quarkus-actor-binding</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
        <!-- Not for anything of policy's own - it has no entities - but agent-os-quarkus-actor-
             binding's own QuarkusAgentActorResolver does a real forwardmeasure-jpa-identity Actor
             lookup (see its own doc comment) inside every agentActors.withActor(...) call, so this
             core ORM extension is required even though this vertical persists nothing itself. The
             DB driver/config-format/health/validation/container-image extensions are deployment-
             only concerns - see agent-os-deployments/policy/quarkus. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-orm</artifactId>
        </dependency>
    </dependencies>
</project>
