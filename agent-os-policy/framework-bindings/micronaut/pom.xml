<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.forwardmeasure.agentos</groupId>
        <artifactId>forwardmeasure-agent-os-micronaut-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../../parents/micronaut/pom.xml</relativePath>
    </parent>

    <groupId>com.forwardmeasure.agentos</groupId>
    <artifactId>agent-os-policy-micronaut</artifactId>
    <packaging>jar</packaging>

    <name>ForwardMeasure Agent OS :: Policy :: Micronaut</name>
    <description>Micronaut wiring and JAX-RS resource hosting for policy evaluation, using the shared agent-os-micronaut-actor-binding for auth/claims resolution. No JDBC/JPA starters - this vertical has no persistence of its own, so no MicronautTransactionalServiceProxy is needed either. Wiring only - no Dockerfile, no application.yaml, no container-image profile; see agent-os-deployments/policy/micronaut (agent-os-policy-micronaut-service) for the deployable assembly that depends on this module, mirroring openworkflow-definition-management-micronaut/-micronaut-service's split exactly.</description>


    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>agent-os-policy-jaxrs</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>agent-os-policy-opa</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>agent-os-policy-drools</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>agent-os-micronaut-actor-binding</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micronaut</groupId>
            <artifactId>micronaut-context</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micronaut.jaxrs</groupId>
            <artifactId>micronaut-jaxrs-server</artifactId>
        </dependency>
        <dependency>
            <!-- Serde runtime for the generated models (request bodies, responses and the RFC 9457
                 Problem every mapped failure returns), whose @Serdeable introspection the models
                 modules build from source. -->
            <groupId>io.micronaut.serde</groupId>
            <artifactId>micronaut-serde-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micronaut</groupId>
            <artifactId>micronaut-inject-java</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- micronaut-jaxrs-processor turns the bare resource and exception-mapper
                         subclasses' inherited JAX-RS annotations into real Micronaut routes and
                         mapper beans - without it they compile and inject but serve nothing.
                         micronaut-validation-processor makes every route whose inherited contract
                         method carries a constraint (@Valid body, @NotNull/@Size header, ...) a
                         validated route, as Hibernate Validator does on Quarkus and Spring;
                         violations reach forwardmeasure-platform-micronaut-validation's
                         MicronautConstraintViolationProblemHandler. The generated models' own
                         serde/validation introspection is built in the models modules, from
                         source. -->
                    <annotationProcessorPaths combine.children="append">
                        <path>
                            <groupId>io.micronaut</groupId>
                            <artifactId>micronaut-inject-java</artifactId>
                        </path>
                        <path>
                            <groupId>io.micronaut.jaxrs</groupId>
                            <artifactId>micronaut-jaxrs-processor</artifactId>
                        </path>
                        <path>
                            <groupId>io.micronaut.validation</groupId>
                            <artifactId>micronaut-validation-processor</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
