<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.forwardmeasure.agentos</groupId>
        <artifactId>agent-os-governance-management-service</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>com.forwardmeasure.agentos</groupId>
    <artifactId>agent-os-governance-management-server-jaxrs</artifactId>
    <packaging>jar</packaging>

    <name>ForwardMeasure Agent OS :: governance-management-service :: Server (JAX-RS)</name>
    <description>Generated JAX-RS interface stubs.</description>

    <dependencies>
        <!-- Real Maven dependency so the reactor build-order sorter builds agent-os-api-specifications
        first - <artifactItems> below alone is invisible to reactor ordering. provided: only needed
        to unpack resources at build time. -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>agent-os-api-specifications</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>agent-os-governance-management-models</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>unpack-openapi-spec</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>unpack</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>${project.groupId}</groupId>
                                    <artifactId>agent-os-api-specifications</artifactId>
                                    <version>${project.version}</version>
                                    <type>jar</type>
                                    <includes>META-INF/openapi/**</includes>
                                    <outputDirectory>${project.build.directory}/unpacked-openapi-spec</outputDirectory>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>generate-agent-os-governance-management-jaxrs</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.build.directory}/unpacked-openapi-spec/META-INF/openapi/agent-governance-management.openapi.yaml</inputSpec>
                            <generatorName>jaxrs-spec</generatorName>
                            <skipValidateSpec>false</skipValidateSpec>
                            <apiPackage>com.forwardmeasure.agentos.governance.api</apiPackage>
                            <modelPackage>com.forwardmeasure.agentos.governance.api.model</modelPackage>
                            <invokerPackage>com.forwardmeasure.agentos.governance.api</invokerPackage>
                            <generateApis>true</generateApis>
                            <generateModels>false</generateModels>
                            <generateSupportingFiles>false</generateSupportingFiles>
                            <generateApiTests>false</generateApiTests>
                            <generateApiDocumentation>false</generateApiDocumentation>
                            <configOptions>
                                <hideGenerationTimestamp>true</hideGenerationTimestamp>
                                <useJakartaEe>true</useJakartaEe>
                                <useSwaggerAnnotations>false</useSwaggerAnnotations>
                                <interfaceOnly>true</interfaceOnly>
                                <returnResponse>true</returnResponse>
                                <sourceFolder>src/main/java</sourceFolder>
                                <useBeanValidation>true</useBeanValidation>
                                <useTags>true</useTags>
                            </configOptions>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
