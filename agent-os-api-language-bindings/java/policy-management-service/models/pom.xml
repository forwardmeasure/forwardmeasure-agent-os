<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.forwardmeasure.agentos</groupId>
        <!-- The Micronaut parent, as forwardmeasure-entity-intelligence-common-models: Micronaut's
             serde and validation processors run here, so their versions come from the Micronaut
             BOM. The jar stays framework-neutral at runtime - see the provided-scope Micronaut
             dependencies below. -->
        <artifactId>forwardmeasure-agent-os-micronaut-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../../../parents/micronaut/pom.xml</relativePath>
    </parent>

    <groupId>com.forwardmeasure.agentos</groupId>
    <artifactId>agent-os-policy-management-models</artifactId>
    <packaging>jar</packaging>

    <name>ForwardMeasure Agent OS :: policy-management-service :: Models</name>
    <description>Generated request/response models.</description>

    <dependencies>
        <!-- Real Maven dependency so the reactor build-order sorter builds agent-os-api-specifications
        first - <artifactItems> below alone is invisible to reactor ordering. provided: only needed
        to unpack resources at build time. -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>agent-os-api-specifications</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
        <!--
        provided: @Serdeable (configOptions additionalModelTypeAnnotations/
        additionalEnumTypeAnnotations below) only has to compile here. Micronaut deployments carry
        these jars anyway; on Quarkus and Spring the annotation and the generated introspection
        classes are never loaded. Mirrors forwardmeasure-entity-intelligence-common-models.
        -->
        <dependency>
            <groupId>io.micronaut.serde</groupId>
            <artifactId>micronaut-serde-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.micronaut</groupId>
            <artifactId>micronaut-core</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!--
                    Micronaut's serde and validation introspection for every generated model is
                    built here, from source, in the same compilation as the models - not in a
                    Micronaut binding from this jar, where Micronaut loses type-argument annotations
                    (List<@Valid X>, Map<String, @Valid X>) and silently skips nested validation
                    that Hibernate Validator performs on Quarkus and Spring.
                    -->
                    <annotationProcessorPaths combine.children="append">
                        <path>
                            <groupId>io.micronaut</groupId>
                            <artifactId>micronaut-inject-java</artifactId>
                        </path>
                        <path>
                            <groupId>io.micronaut.serde</groupId>
                            <artifactId>micronaut-serde-processor</artifactId>
                        </path>
                        <path>
                            <groupId>io.micronaut.validation</groupId>
                            <artifactId>micronaut-validation-processor</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>unpack-openapi-spec</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>unpack</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>${project.groupId}</groupId>
                                    <artifactId>agent-os-api-specifications</artifactId>
                                    <version>${project.version}</version>
                                    <type>jar</type><classifier>early</classifier>
                                    <includes>META-INF/openapi/**</includes>
                                    <outputDirectory>${project.build.directory}/unpacked-openapi-spec</outputDirectory>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>generate-agent-os-policy-management-models</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.build.directory}/unpacked-openapi-spec/META-INF/openapi/agent-policy-management.openapi.yaml</inputSpec>
                            <generatorName>jaxrs-spec</generatorName>
                            <skipValidateSpec>false</skipValidateSpec>
                            <modelPackage>com.forwardmeasure.agentos.policy.api.model</modelPackage>
                            <generateApis>false</generateApis>
                            <generateModels>true</generateModels>
                            <generateSupportingFiles>false</generateSupportingFiles>
                            <generateApiTests>false</generateApiTests>
                            <generateModelTests>false</generateModelTests>
                            <generateApiDocumentation>false</generateApiDocumentation>
                            <generateModelDocumentation>false</generateModelDocumentation>
                            <configOptions>
                                <hideGenerationTimestamp>true</hideGenerationTimestamp>
                                <useJakartaEe>true</useJakartaEe>
                                <useSwaggerAnnotations>false</useSwaggerAnnotations>
                                <disallowAdditionalPropertiesIfNotPresent>true</disallowAdditionalPropertiesIfNotPresent>
                                <openApiNullable>false</openApiNullable>
                                <sourceFolder>src/main/java</sourceFolder>
                                <useBeanValidation>true</useBeanValidation>
                                <!-- Every model and enum @Serdeable, so the processors above build
                                     its Micronaut introspection from source. -->
                                <additionalModelTypeAnnotations>@io.micronaut.serde.annotation.Serdeable</additionalModelTypeAnnotations>
                                <additionalEnumTypeAnnotations>@io.micronaut.serde.annotation.Serdeable</additionalEnumTypeAnnotations>
                            </configOptions>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
