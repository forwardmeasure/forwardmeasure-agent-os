<!-- Test fixture for AgentOsServiceFixture: the actors the deployment HTTP tests authenticate as,
     seeded into the tenant database's shared identity schema the way tenant-access provisioning
     provisions them - after the migration Job has created that schema. The subjects are the
     Keycloak-assigned user ids of the fixture's identities, known only once Keycloak is running,
     so they arrive as changelog parameters. -->
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    logicalFilePath="db/changelog/agent-os-service-test-fixtures.xml"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="agent-os-service-test-fixtures-001-actors" author="forwardmeasure">
        <insert schemaName="identity" tableName="actor">
            <column name="identity_provider" value="keycloak" />
            <column name="subject_identifier" value="${agentos.fixture.enabled-subject}" />
            <column name="identity_type" value="HUMAN" />
        </insert>
        <insert schemaName="identity" tableName="actor">
            <column name="identity_provider" value="keycloak" />
            <column name="subject_identifier" value="${agentos.fixture.disabled-subject}" />
            <column name="identity_type" value="SERVICE" />
            <column name="disabled_at" valueComputed="CURRENT_TIMESTAMP" />
        </insert>
    </changeSet>
</databaseChangeLog>
